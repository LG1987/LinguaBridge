# build output
dist/
.artifacts/

# release/ is intentionally TRACKED: it ships the load-unpacked zip and its
# checksum metadata so the package can be downloaded without building.
# Regenerate with: pwsh -File scripts\package.ps1

# toolchains / caches kept inside the project
.venv/
.python/
.uvtool/
.uv-cache/
.npm-cache/
node_modules/
.tmp/
.logs/

# downloaded models (≈140 MB) and their archives
service/models/
.tmp/model-downloads/

# local engine logs / pid files
*.log
*.pid

# provider secrets (GLM api key etc.) — never commit
service/providers.local.json

# python
__pycache__/
*.pyc
